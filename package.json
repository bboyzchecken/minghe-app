{
  "name": "minghe",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @minghe/app dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "api:dev": "cd apps/api && go run .",
    "api:seed": "cd apps/api && go run . seed",
    "up": "docker compose up --build -d",
    "down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
