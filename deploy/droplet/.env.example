# /opt/minghe/.env — ความลับของ production API (ห้าม commit)
# สร้างจากไฟล์นี้ครั้งเดียวด้วย setup.sh แล้วแก้ค่าให้ครบ

# image ที่ deploy อยู่ — GitHub Actions อัปเดตบรรทัดนี้ให้ทุกครั้ง (rollback = แก้เป็น tag เดิมแล้ว docker compose up -d)
MINGHE_API_IMAGE=ghcr.io/bboyzchecken/minghe-api:latest
API_DOMAIN=api.minghe.work
# โดเมนของหน้าบ้าน — Caddy เสิร์ฟ static จาก /opt/minghe/web บนเครื่องเดียวกัน
# ต้องมี A record ชี้มาที่ Reserved IP เดียวกันกับ API ไม่งั้น Caddy ออก TLS ให้ไม่ได้
WEB_DOMAIN=uat.minghe.work

# ---- ต้องตั้ง ----
JWT_SECRET_KEY=            # openssl rand -hex 32
MYSQL_ROOT_PASSWORD=       # openssl rand -hex 16
MYSQL_DATABASE=minghe

# ---- หน้าบ้าน ----
APP_BASE_URL=https://minghe.work
# ต้องมี origin ของหน้าบ้านที่ใช้จริง ไม่งั้นเบราว์เซอร์บล็อกทุก request ไป API
CORS_ALLOWED_ORIGINS=https://uat.minghe.work,https://minghe.work,https://www.minghe.work

# ---- production ต้องปิดทั้งสองตัวนี้ ----
MINGHE_SEED_DEMO_ACCOUNTS=false
MINGHE_OTP_ECHO=false
# ⚠️ รอบ UAT: ถ้ายังไม่ได้ตั้ง GMAIL_* ข้างล่าง ผู้ทดสอบจะ "สมัครสมาชิกไม่ได้" เพราะ OTP ไม่ถูกส่ง
#    ทางออกชั่วคราวเฉพาะช่วงทดสอบ — ตั้งเป็น true แล้วระบบจะแสดงรหัสบนหน้าจอแทนการส่งอีเมล
#    (ตรงกับที่เอกสาร docs/uat-2026-09-09-known-gaps.md บอกผู้ทดสอบไว้แล้ว)
#    🔴 ต้องกลับเป็น false ทันทีที่จบ UAT — ไม่งั้นใครก็สมัครบัญชีได้
MINGHE_GOOGLE_LOGIN_ENABLED=false
# สมัครสมาชิกต้องยืนยันอีเมลด้วย OTP หรือไม่ — docker-compose.yml ตั้งค่าตั้งต้นเป็น false ไว้ช่วงทดสอบ
# ส่งอีเมลได้เสถียรแล้วให้ตั้งเป็น true (รีเซ็ตรหัสผ่านใช้ OTP เสมอไม่ว่าค่านี้เป็นอะไร)
# MINGHE_OTP_REQUIRED=true

# ---- ส่งอีเมล OTP / รายงาน ----
# MAIL_TRANSPORT บังคับช่องทาง: gmail | resend | smtp | log
# เว้นว่าง = เลือกเองตามลำดับ Resend → SMTP → Gmail → log ซึ่งเดาผิดได้ง่าย
# เมื่อ .env เก็บค่าของหลายช่องทางไว้พร้อมกัน จึงควรระบุให้ชัดบน production
#
# ⚠️ พอร์ต SMTP ขาออกของ Droplet บน DigitalOcean ถูกบล็อกตามนโยบายกันสแปม
#    วัดจริงเมื่อ 10 ก.ย. 2569 จากเครื่อง production: 25 / 465 / 587 ตันหมด
#    (ส่วน 80 / 3535 ที่เคยจดว่า "ตัน" นั้น GoDaddy ไม่ได้เปิดให้บริการอยู่แล้ว —
#     ยิงจากเครื่องที่บ้านก็ไม่ติดเหมือนกัน จึงไม่ใช่หลักฐานว่า DO บล็อก)
#    ปลดล็อกได้ด้วยการเปิด ticket กับ DigitalOcean — ระหว่างที่ยังไม่ปลด
#    ใช้ได้เฉพาะช่องทางที่วิ่งผ่าน HTTPS คือ gmail และ resend เท่านั้น
MAIL_TRANSPORT=gmail

# ---- ช่องทางที่สอง: Resend (HTTPS) ----
# ช่องทางนี้เตรียมไว้เผื่อ แต่ยังไม่ได้สมัครบัญชี (10 ก.ย. 2569) — ของจริงตอนนี้ใช้ Gmail API
# ข้อดีคือวิ่งผ่าน HTTPS 443 เหมือนกัน จึงไม่ติดนโยบายบล็อก SMTP ของ DigitalOcean
# MAIL_SENDER_EMAIL ต้องอยู่ในโดเมนที่ยืนยันแล้วในหน้า Domains ของ Resend
RESEND_API_KEY=
MAIL_SENDER_EMAIL=info@minghe.work
MAIL_SENDER_NAME=命合 Mìnghé

# ---- ช่องทางสำรอง: SMTP (ใช้ไม่ได้บนเครื่องที่พอร์ต SMTP ถูกบล็อก) ----
# ไม่มีค่าเหล่านี้ = ระบบเขียนอีเมลลง log แทนการส่ง ผู้ใช้จะสมัครสมาชิกไม่ได้เพราะไม่ได้รับ OTP
# GoDaddy Workspace Email ใช้ smtpout.secureserver.net · Professional Email (M365) ใช้ smtp.office365.com
# SMTP_SENDER_EMAIL ต้องเป็นที่อยู่เดียวกับ SMTP_USERNAME — GoDaddy ปฏิเสธการส่งในนามที่อยู่อื่น
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
SMTP_USERNAME=info@minghe.work
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=info@minghe.work
SMTP_SENDER_NAME=命合 Mìnghé

# ---- ช่องทางสำรอง: Gmail API ----
# ใช้ก็ต่อเมื่อ SMTP_HOST ว่าง · scope gmail.send เป็น sensitive scope ที่ Google บล็อกจนกว่าแอปจะผ่าน
# verification จึงคุ้มเฉพาะกรณีมี Google Workspace ของโดเมนเอง (ตั้ง OAuth app เป็น Internal ได้)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=
# ต้องเป็นบัญชีเดียวกับที่กด Authorize ตอนออก refresh token — Gmail ส่งในนามบัญชีนั้นเสมอ
GMAIL_SENDER_EMAIL=work.minghe@gmail.com
GMAIL_SENDER_NAME=命合 Mìnghé

# ---- Google OAuth (เมื่อเปิด F-02 Google login) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://minghe.work/auth/google/callback

# ---- Cloudflare R2 ----
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_IMAGE_BUCKET=minghe-images
R2_VIDEO_BUCKET=minghe-videos

# ---- Payment (GB Prime Pay) ----
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---- เวอร์ชันเอกสารกฎหมายที่มีผล ----
LEGAL_TERMS_VERSION=draft
LEGAL_PRIVACY_VERSION=draft
LEGAL_REFUND_VERSION=draft
LEGAL_COOKIES_VERSION=draft
