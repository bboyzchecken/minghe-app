# /opt/minghe/.env — ความลับของ production API (ห้าม commit)
# สร้างจากไฟล์นี้ครั้งเดียวด้วย setup.sh แล้วแก้ค่าให้ครบ

# image ที่ deploy อยู่ — GitHub Actions อัปเดตบรรทัดนี้ให้ทุกครั้ง (rollback = แก้เป็น tag เดิมแล้ว docker compose up -d)
MINGHE_API_IMAGE=ghcr.io/bboyzchecken/minghe-api:latest
API_DOMAIN=api.minghe.work

# ---- ต้องตั้ง ----
JWT_SECRET_KEY=            # openssl rand -hex 32
MYSQL_ROOT_PASSWORD=       # openssl rand -hex 16
MYSQL_DATABASE=minghe

# ---- หน้าบ้าน ----
APP_BASE_URL=https://minghe.work
CORS_ALLOWED_ORIGINS=https://minghe.work,https://www.minghe.work,https://minghe-work.pages.dev

# ---- production ต้องปิดทั้งสองตัวนี้ ----
MINGHE_SEED_DEMO_ACCOUNTS=false
MINGHE_OTP_ECHO=false
# ⚠️ รอบ UAT: ถ้ายังไม่ได้ตั้ง GMAIL_* ข้างล่าง ผู้ทดสอบจะ "สมัครสมาชิกไม่ได้" เพราะ OTP ไม่ถูกส่ง
#    ทางออกชั่วคราวเฉพาะช่วงทดสอบ — ตั้งเป็น true แล้วระบบจะแสดงรหัสบนหน้าจอแทนการส่งอีเมล
#    (ตรงกับที่เอกสาร docs/uat-2026-09-09-known-gaps.md บอกผู้ทดสอบไว้แล้ว)
#    🔴 ต้องกลับเป็น false ทันทีที่จบ UAT — ไม่งั้นใครก็สมัครบัญชีได้
MINGHE_GOOGLE_LOGIN_ENABLED=false

# ---- ส่งอีเมล OTP / รายงาน (Gmail API) — ต้องตั้งเมื่อ MINGHE_OTP_ECHO=false ไม่งั้นสมัครสมาชิกไม่ได้ ----
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=
GMAIL_SENDER_EMAIL=info@minghe.work

# ---- Google OAuth (เมื่อเปิด F-02 Google login) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://minghe.work/auth/google/callback

# ---- Cloudflare R2 ----
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_IMAGE_BUCKET=minghe-images
R2_VIDEO_BUCKET=minghe-videos

# ---- Payment (GB Prime Pay) ----
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---- เวอร์ชันเอกสารกฎหมายที่มีผล ----
LEGAL_TERMS_VERSION=draft
LEGAL_PRIVACY_VERSION=draft
LEGAL_REFUND_VERSION=draft
LEGAL_COOKIES_VERSION=draft
