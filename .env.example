# ╔══════════════════════════════════════════════════════════════════╗
# ║  MingHe — ไฟล์ตั้งค่ากลางของทั้งโปรเจกต์                          ║
# ║  คัดลอกเป็น .env แล้วแก้ที่นี่ที่เดียว ทั้งหน้าเว็บและ API อ่านไฟล์นี้  ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── สวิตช์หลัก ─────────────────────────────────────────────────────
# mock = ทำงานในเบราว์เซอร์ล้วน ไม่ต้องมี API/ฐานข้อมูล และเปิดปุ่มบัญชีทดลองให้กด
# live = ต่อกับ Go API จริงที่ apps/api (ต้องรัน MySQL + go run . ก่อน)
MINGHE_MODE=mock

# URL ของ API — ใช้เฉพาะโหมด live
MINGHE_API_BASE_URL=http://localhost:5000

# เปิด/ปิดปุ่มเข้าสู่ระบบด้วย Google
# ตอนนี้เป็น false โดยตั้งใจ — ปุ่มยังแสดงอยู่แต่กดไม่ได้ รอ OAuth client จริง (F-02)
MINGHE_GOOGLE_LOGIN_ENABLED=false

# ── ฝั่งเว็บ ────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:4311

# ── ฝั่ง API ────────────────────────────────────────────────────────
ENV=development
PORT=5000
JWT_SECRET_KEY=change_this_secret_key

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=minghe

# Sign in with Google (ฝั่งผู้ใช้) — เว้นว่างไว้จนกว่าจะได้ OAuth client
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:4311/auth/google/callback

# Gmail API — บัญชีที่ใช้ส่ง OTP (คนละชุดกับ OAuth ด้านบน)
# เว้นว่าง = ระบบจะพิมพ์อีเมลลง log แทนการส่งจริง ใช้ทดสอบในเครื่องได้เลย
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=
GMAIL_SENDER_EMAIL=info@minghe.work

# Cloudflare R2 — เว้นว่าง = ปิดการอัปโหลดไฟล์
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_IMAGE_BUCKET=minghe-images
R2_VIDEO_BUCKET=minghe-videos

# Payment gateway — ยังไม่สรุปว่าใช้เจ้าไหน (Q0-3)
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# เวอร์ชันเอกสารกฎหมายที่มีผลบังคับใช้ (F-01/F-06)
LEGAL_TERMS_VERSION=draft
LEGAL_PRIVACY_VERSION=draft
LEGAL_REFUND_VERSION=draft
LEGAL_COOKIES_VERSION=draft

# Redis (ยังไม่ได้ใช้)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
