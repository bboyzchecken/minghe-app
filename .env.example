# ╔══════════════════════════════════════════════════════════════════╗
# ║  MingHe — ไฟล์ตั้งค่ากลางของทั้งโปรเจกต์                          ║
# ║  คัดลอกเป็น .env แล้วแก้ที่นี่ที่เดียว                              ║
# ║  · docker compose อ่านไฟล์นี้เพื่อแทนค่า ${VAR}                    ║
# ║  · รันนอก Docker: apps/app (next.config.mjs) และ apps/api (godotenv) ║
# ║    อ่านไฟล์เดียวกันนี้                                             ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── สวิตช์หลัก (มีผลเฉพาะตอนรันนอก Docker — compose ตรึงเป็น live เสมอ) ──
# mock = ทำงานในเบราว์เซอร์ล้วน ไม่ต้องมี API/ฐานข้อมูล และเปิดปุ่มบัญชีทดลองให้กด
# live = ต่อกับ Go API จริงที่ apps/api
MINGHE_MODE=live

# URL ของ API — ใช้เฉพาะโหมด live ตอนรัน next dev (ใน Docker ใช้ /backend ผ่าน nginx)
MINGHE_API_BASE_URL=http://localhost:5000

# เปิด/ปิดปุ่มเข้าสู่ระบบด้วย Google — ปุ่มยังแสดงอยู่แต่กดไม่ได้จนกว่าจะมี OAuth client (F-02)
MINGHE_GOOGLE_LOGIN_ENABLED=false

# ── Docker compose ─────────────────────────────────────────────────
# พอร์ตหน้าเว็บบนเครื่องโฮสต์ (เครื่องอื่นใน LAN เปิด http://<IP>:WEB_PORT)
WEB_PORT=8080
MYSQL_ROOT_PASSWORD=minghe_root_2026
# เครื่องเดโม: สร้างบัญชีทดลอง + คำสั่งซื้อตัวอย่างแม้โหมด live (ดูรายชื่อใน README)
MINGHE_SEED_DEMO_ACCOUNTS=true
# ยังไม่มี Gmail credential → แสดงรหัส OTP บนหน้าจอตอนสมัครสมาชิก  ⚠️ production ต้องเป็น false
MINGHE_OTP_ECHO=true

# ── ฝั่งเว็บ / CORS ──────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
# origin เพิ่มเติมที่อนุญาตให้เรียก API (คั่นด้วย comma) เช่น https://minghe.work,https://www.minghe.work
CORS_ALLOWED_ORIGINS=

# ── ฝั่ง API (ตอนรันด้วย go run . — ใน Docker compose ตั้งให้เอง) ──
ENV=development
PORT=5000
JWT_SECRET_KEY=change_this_secret_key

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=minghe

# Sign in with Google (ฝั่งผู้ใช้) — เว้นว่างไว้จนกว่าจะได้ OAuth client
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Gmail API — บัญชีที่ใช้ส่ง OTP (คนละชุดกับ OAuth ด้านบน)
# เว้นว่าง = ระบบจะพิมพ์อีเมลลง log แทนการส่งจริง (และถ้า MINGHE_OTP_ECHO=true จะแสดงรหัสบนหน้าจอ)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=
GMAIL_SENDER_EMAIL=info@minghe.work

# Cloudflare R2 — เว้นว่าง = ปิดการอัปโหลดไฟล์
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_IMAGE_BUCKET=minghe-images
R2_VIDEO_BUCKET=minghe-videos

# Payment gateway — GB Prime Pay (Q0-3) รอเอกสารกฎหมายครบจึงเปิดใช้
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# เวอร์ชันเอกสารกฎหมายที่มีผลบังคับใช้ (F-01/F-06)
LEGAL_TERMS_VERSION=draft
LEGAL_PRIVACY_VERSION=draft
LEGAL_REFUND_VERSION=draft
LEGAL_COOKIES_VERSION=draft

# Redis (ยังไม่ได้ใช้)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
