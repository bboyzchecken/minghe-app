{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["MINGHE_MODE", "MINGHE_API_BASE_URL", "MINGHE_GOOGLE_LOGIN_ENABLED"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "lint": {}
  }
}
