ENV=development
PORT=5000
APP_BASE_URL=http://localhost:4311

# JWT — ต้องเปลี่ยนก่อนขึ้น production
JWT_SECRET_KEY=change_this_secret_key

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=minghe

# Sign in with Google (F-02) — client ฝั่งผู้ใช้
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:4311/auth/google/callback

# Gmail API — บัญชีที่ใช้ส่ง OTP (คนละชุดกับ OAuth ด้านบน)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=
GMAIL_SENDER_EMAIL=info@minghe.work

# Cloudflare R2
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_IMAGE_BUCKET=minghe-images
R2_VIDEO_BUCKET=minghe-videos

# Payment gateway (Q0-3 — ยังไม่สรุปว่าใช้เจ้าไหน)
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# เวอร์ชันเอกสารกฎหมายที่มีผลบังคับใช้ (F-01/F-06)
# ใช้เป็นค่าสำรองเมื่อยังไม่มีเรคคอร์ดในตาราง legal_documents
LEGAL_TERMS_VERSION=draft
LEGAL_PRIVACY_VERSION=draft
LEGAL_REFUND_VERSION=draft
LEGAL_COOKIES_VERSION=draft

# Redis (ยังไม่ได้ใช้ — เผื่อทำ rate limit แบบกระจาย)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── เพิ่ม 22 ส.ค. 2026 ──
# ส่งรหัส OTP กลับใน response เมื่อยังไม่ตั้งค่า Gmail (ทดสอบ/เดโมใน LAN เท่านั้น — production ต้อง false)
MINGHE_OTP_ECHO=false
# seed บัญชีทดลอง + คำสั่งซื้อตัวอย่างแม้อยู่โหมด live (เครื่องเดโม)
MINGHE_SEED_DEMO_ACCOUNTS=false
# origin ของหน้าเว็บที่อนุญาตเพิ่มเติม คั่นด้วย comma (เช่น https://minghe.work,https://www.minghe.work)
CORS_ALLOWED_ORIGINS=
